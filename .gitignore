# SLA-Slicer repository policy: the repository holds exactly what a clean clone needs to build the app,
# build and run the C++ CTest unit suites, build the portable bundle / native packages, and the
# user/developer documentation and licences. Local QA tooling (GUI/oracle/dist/perf/acceptance scripts,
# the internal status log) stays on disk but is ignored here.

# ---- Build output -------------------------------------------------------
/build/
/build-*/
!/build-utils/
/dist/
/deps/build/
/deps/build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/

# IDE / editor
.vscode/
.idea/

# Local helper tools
/.local-tools/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Compiled binaries and libraries produced locally
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.zip
*.tar.*

# Prebuilt Windows GMP/MPFR runtime DLLs used by the Windows build and tests
!/deps/+GMP/gmp/lib/win*/*.dll
!/deps/+MPFR/mpfr/lib/win*/*.dll
!/resources/data/embossed_text.obj
/deps/.pkg_cache/

# Stray output written by a unit test run from the repository root
/Bad_polygon.svg

# Generated by local Python verification scripts
__pycache__/
sla-format-audit/
tests/**/bin/
tests/**/obj/

# ---- doc/: user and developer documentation, licences -------------------
# (internal status log doc/TODO_STATUS.md and the goal document doc/GOAL.md stay local)
/doc/*
!/doc/AUTOMATION.md
!/doc/COMPATIBILITY_INVENTORY.md
!/doc/Dependencies.md
!/doc/DEVELOPER.md
!/doc/EXPOSURE_CALIBRATION_ARCHITECTURE.md
!/doc/LAYER_EDITOR.md
!/doc/Localization_guide.md
!/doc/PCB_CALIBRATION.md
!/doc/TESTING.md
!/doc/THIRD_PARTY_LICENSES.md
!/doc/SBOM.json
!/doc/images/
!/doc/licenses/

# ---- tools/: build, bundle and packaging helpers only --------------------
/tools/*
!/tools/docker/
!/tools/bundle_native_libraries.py
!/tools/generate_sbom.py
!/tools/make_relocatable_bundle.sh
!/tools/qa/
/tools/qa/*
!/tools/qa/import_hershey_font_data.py
!/tools/release/
/tools/release/*
!/tools/release/make_native_packages.sh
!/tools/release/make_source_tarball.sh
!/tools/release/sign_release.sh
!/tools/release/make_release.sh

# ---- tests/: C++ CTest unit suites only ---------------------------------
# Local QA (tests/gui, tests/oracle, tests/dist, tests/perf, tests/architecture, the Python/C# oracles
# in tests/sla_print and the fixtures only they use) is ignored. tests/CMakeLists.txt and
# tests/sla_print/CMakeLists.txt register those scripts only when the files exist.
/tests/*
!/tests/CMakeLists.txt
!/tests/catch_main.hpp
!/tests/test_utils.hpp
!/tests/arrange/
!/tests/cpp17/
!/tests/data/
!/tests/gui_background_events/
!/tests/gui_window_geometry/
!/tests/libslic3r/
!/tests/sla_print/
!/tests/thumbnails/

/tests/sla_print/*
!/tests/sla_print/CMakeLists.txt
!/tests/sla_print/*.cpp
!/tests/sla_print/*.hpp
/tests/sla_print/*_oracle.cpp

# Test data: only what the C++ suites read (mesh fixtures are owned: *.obj re-included after the global rule).
!/tests/data/**/*.obj
/tests/data/anycubic_515_legacy_model/
/tests/data/anycubic_515_legacy_pcb/
/tests/data/pm4n_515_legacy/
/tests/data/layer_plane_workflow/
/tests/data/fresh_model_project/
/tests/data/sla_retained_pipeline/
/tests/data/sla_expert_instances/
/tests/data/clipper_intersection_order.cpp
