# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# Product name shown to users (window title, About, dialogs, desktop entry).
set(SLIC3R_APP_NAME "SLA-Slicer")
# APP_KEY is the storage key: it names the datadir (~/.config/PrusaSlicer), PrusaSlicer.ini and
# the wx app name. It stays "PrusaSlicer" so existing user presets keep working (no migration needed).
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_VERSION "2.9.4")
set(SLIC3R_BUILD_ID "SLA-Slicer-${SLIC3R_VERSION}+UNKNOWN")
set(SLIC3R_RC_VERSION "2,9,4,0")
set(SLIC3R_RC_VERSION_DOTS "2.9.4.0")
