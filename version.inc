# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# Product name shown to users (window title, About, dialogs, desktop entry).
set(SLIC3R_APP_NAME "SLA-Slicer")
# APP_KEY is the storage key: it names the data directory (~/.config/SLA-Slicer), SLA-Slicer.ini,
# the wx app name and the gettext domain (resources/localization/<lang>/SLA-Slicer.mo). It is
# deliberately NOT "PrusaSlicer": a real PrusaSlicer installed next to us must never share (and
# possibly damage) our configuration. On first start the SLA part of an existing
# ~/.config/PrusaSlicer is COPIED over (see LegacyDataMigration).
set(SLIC3R_APP_KEY "SLA-Slicer")

# Product version shown to users (title bar, About, --version, package names).
set(SLA_SLICER_VERSION "1.0.0")

# Version of the PrusaSlicer code base. This is a COMPATIBILITY version, not the product version:
# vendor bundles (min_slic3r_version), ini/3MF headers and config upgrade logic compare against it.
# Do not change it for a product release.
set(SLIC3R_VERSION "2.9.4")

# Build id: "SLA-Slicer-<product version>+<git describe | override | source>", see cmake/SlaSlicerBuildId.cmake.
# SLIC3R_BUILD_ID is computed there (after this file is included).
set(SLIC3R_RC_VERSION "1,0,0,0")
set(SLIC3R_RC_VERSION_DOTS "1.0.0.0")
